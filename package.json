  "description": "CCursor BYOK server, patched to run standalone in Docker — point cursor-agent / any ConnectRPC client at your own API keys.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "ccursor-cli": "bin/ccursor-cli.mjs",
    "ccursor": "bin/ccursor-cli.mjs"
  },
  "files": [
    "bin/",
    "src/cli.mjs",
    "dist/server.cjs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
